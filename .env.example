# ==========================================
# Portfolio Environment Variables
# ==========================================

# GitHub Integration
# Set your GitHub username here to fetch real-time repositories
NEXT_PUBLIC_GITHUB_USERNAME=mrezafdllah

# Cloud Database (Supabase PostgreSQL)
# Create a free project at https://supabase.com and copy the project URL and Anon/Service Role Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-if-using-server-side

# Optional: Email notification webhook or custom configuration
# CONTACT_NOTIFICATION_EMAIL=your-email@example.com
